# Copy to .env.local for development. Never commit real secrets.
DATABASE_URL=postgres://ordering:ordering@localhost:5432/ordering

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (https in production; cookies become Secure automatically).
BETTER_AUTH_URL=http://localhost:3000
# Uploaded menu images (ADR-011). Mount a persistent volume here in deployment.
UPLOAD_DIR=./storage/uploads
